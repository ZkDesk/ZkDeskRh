{
  "name": "zkdesk-site",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "bin": {
    "zkdesk-agent": "agent/cli.mjs",
    "zkdesk-mcp": "agent/mcp.mjs"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5184",
    "build": "vite build",
    "test": "node src/dashboard/model.test.js && node src/lib/zk/zk.test.js && node api/relay.test.mjs && node api/handlers.test.mjs && node api/crons.test.mjs && node api/nyse.test.mjs && node agent/agent.test.mjs && node agent/alerts.test.mjs && node agent/paywall.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=api/** --test-coverage-exclude=api/**/*.test.mjs --test-coverage-lines=85 api/relay.test.mjs api/handlers.test.mjs api/crons.test.mjs api/nyse.test.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5184",
    "zk:fixtures": "node circuits/scripts/fixtures.mjs",
    "abis": "node contracts/script/export-abis.mjs",
    "privacy": "node scripts/privacy-check.mjs",
    "test:types": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2022 --types node agent/types-check.mts"
  },
  "dependencies": {
    "@aztec/bb.js": "5.0.0-nightly.20260522",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noir-lang/noir_js": "1.0.0-beta.22",
    "@zk-kit/lean-imt": "2.2.5",
    "html-react-parser": "5.2.17",
    "pg": "8.23.0",
    "poseidon-lite": "0.3.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
